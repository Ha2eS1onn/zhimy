# ---------------------------------------------------------------------------
# Supabase（Project Settings → API）
# 未配置时应用会显示配置引导页；如需先看界面，可打开下面的演示模式。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 仅用于本地执行数据库迁移（Project Settings → Database → Connection string → URI）
# 运行时不需要，也绝不要提交真实值。
# 也可以只填数据库密码（脚本会按项目 ref 自动拼出连接串）。
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# 国内网络无法直连 db.<ref>.supabase.co 时，可改用 Supabase 管理 API 执行迁移：
# Account → Access Tokens 生成 token，取消下面两行注释；npm run db:init 会自动走 api.supabase.com
# SUPABASE_ACCESS_TOKEN=sbp_xxxx
# SUPABASE_PROJECT_REF=your-project-ref

# 演示模式：不连接 Supabase，用内存示例数据查看 UI（不要在生产环境开启）
# NEXT_PUBLIC_DEMO_MODE=1

# BYOK 代理允许转发到的服务商域名（逗号分隔；不填则使用内置常见服务商列表）
# LLM_PROXY_ALLOWED_HOSTS=api.openai.com,api.deepseek.com

# ---------------------------------------------------------------------------
# 可选：仅 scripts/embed-backfill.mjs 使用（本地运维回填，勿提交真实值）
# 应用运行时的向量模型在「设置 → 模型 → 向量模型」里配置（Key 只存本机 localStorage），
# 不需要写进环境变量；以下变量只用于批量给存量节点回填向量。
# 必须输出 1024 维（与 nodes.embedding vector(1024) 一致），且与设置里的向量模型相同。
# 示例：text-embedding-3-small（OpenAI 等）、BAAI/bge-m3（硅基流动等）；留空时脚本默认 text-embedding-3-small。
# 注意：Base URL 要带版本前缀（如 https://api.openai.com/v1）；脚本还需上方 SUPABASE_DB_URL 直连 Postgres。
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
