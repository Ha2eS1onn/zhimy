# ---------------------------------------------------------------------------
# Supabase（Project Settings → API）
# 未配置时应用会显示配置引导页；如需先看界面，可打开下面的演示模式。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 仅用于本地执行数据库迁移（Project Settings → Database → Connection string → URI）
# 运行时不需要，也绝不要提交真实值。
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# 演示模式：不连接 Supabase，用内存示例数据查看 UI（不要在生产环境开启）
# NEXT_PUBLIC_DEMO_MODE=1

# BYOK 代理允许转发到的服务商域名（逗号分隔；不填则使用内置常见服务商列表）
# LLM_PROXY_ALLOWED_HOSTS=api.openai.com,api.deepseek.com
